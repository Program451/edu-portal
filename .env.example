# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows PowerShell)

# Секрет для подписи JWT-токенов. Обязателен для продакшена — если не задать,
# сервер сгенерирует случайный секрет на время жизни процесса, и все токены
# "слетят" при перезапуске.
JWT_SECRET=change-me-to-a-long-random-string

# Ключ Groq API — нужен для ИИ-проверки домашних заданий.
GROQ_API_KEY=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

# Порт, на котором слушает сервер (по умолчанию 3000).
PORT=3000

# Папка для базы данных и загруженных файлов (по умолчанию — папка проекта).
DATA_DIR=

# Список разрешённых доменов фронтенда через запятую (CORS), например:
#   ALLOWED_ORIGINS=https://mydomain.kz,https://www.mydomain.kz
# Пока используете временный/бесплатный домен, можно оставить пустым —
# тогда CORS открыт для всех, как и раньше. Задайте это значение, когда
# домен станет постоянным.
ALLOWED_ORIGINS=

# ─── Cloudflare R2 (нужно только для деплоя на Render free tier) ───
# На бесплатном тарифе Render диск не сохраняется между перезапусками.
# R2 используется как резервное хранилище для базы данных (через Litestream,
# см. litestream.yml) и загруженных файлов (через r2-storage.js).
# Если оставить эти поля пустыми — всё работает как раньше, просто без
# резервного копирования (нормально для локальной разработки).
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
